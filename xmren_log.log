python3 << 'EOF'
import torch

model_dir = "/home/ma-user/work/test/model/CosyVoice-claude/huawei_model"
path = f"{model_dir}/flow.pt"

ckpt = torch.load(path, map_location="cpu")
torch.save(ckpt, f"{path}.bak")  # 先备份

if isinstance(ckpt, dict):
    # 去掉训练元信息
    for k in ["epoch", "step", "optimizer", "scheduler", "config"]:
        ckpt.pop(k, None)

    # 若权重在 model / state_dict 子字典里
    if "state_dict" in ckpt:
        ckpt = ckpt["state_dict"]
    elif "model" in ckpt and isinstance(ckpt["model"], dict):
        ckpt = ckpt["model"]
    elif "flow" in ckpt and isinstance(ckpt["flow"], dict):
        ckpt = ckpt["flow"]

    # 去掉 key 前缀 flow. / module.
    cleaned = {}
    for k, v in ckpt.items():
        nk = k
        if nk.startswith("module."):
            nk = nk[len("module."):]
        if nk.startswith("flow."):
            nk = nk[len("flow."):]
        cleaned[nk] = v
    ckpt = cleaned

torch.save(ckpt, path)
print("saved cleaned flow.pt, num_keys=", len(ckpt))
print("sample keys:", list(ckpt.keys())[:8])
EOF




